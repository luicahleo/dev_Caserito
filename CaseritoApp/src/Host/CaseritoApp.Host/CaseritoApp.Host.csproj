<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\CaseritoApp.BuildingBlocks.Application\CaseritoApp.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\CaseritoApp.BuildingBlocks.Infrastructure\CaseritoApp.BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Identity\CaseritoApp.Identity.Infrastructure\CaseritoApp.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Catalog\CaseritoApp.Catalog.Infrastructure\CaseritoApp.Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Chat\CaseritoApp.Chat.Application\CaseritoApp.Chat.Application.csproj" />
    <ProjectReference Include="..\..\Chat\CaseritoApp.Chat.Infrastructure\CaseritoApp.Chat.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Orders\CaseritoApp.Orders.Application\CaseritoApp.Orders.Application.csproj" />
    <ProjectReference Include="..\..\Notifications\CaseritoApp.Notifications.Application\CaseritoApp.Notifications.Application.csproj" />
    <ProjectReference Include="..\..\Notifications\CaseritoApp.Notifications.Infrastructure\CaseritoApp.Notifications.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Orders\CaseritoApp.Orders.Infrastructure\CaseritoApp.Orders.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Reputation\CaseritoApp.Reputation.Infrastructure\CaseritoApp.Reputation.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d4b2f165-d494-4acb-818d-f69c0b306519</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!-- Requerido por las herramientas de dotnet ef (proyecto de inicio) para generar migraciones;
         no se usa en tiempo de ejecución. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Emite el documento OpenAPI, sin levantar el servidor, para versionarlo como contrato
         y generar el cliente TS. Es opt-in vía -p:GenerateOpenApi=true: emitir instancia el host
         completo (HostFactoryResolver), lo que dispara el fail-fast del encryptor de Identity fuera
         de Testing/Development y ValidateOnBuild en Development sin DbContext. Un `dotnet build`
         normal (sin la propiedad) NO debe emitir ni instanciar el host. -->
    <OpenApiGenerateDocumentsOnBuild Condition="'$(GenerateOpenApi)' == 'true'">true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiGenerateDocumentsOnBuild Condition="'$(GenerateOpenApi)' != 'true'">false</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../artifacts/openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

</Project>
