{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Facebook": {
      "AppId": "",
      "AppSecret": ""
    }
  },
  "Chat": {
    "TiempoReal": {
      "MaximoConversaciones": 20,
      "MaximoInvocacionesPorMinuto": 60,
      "TamanoMaximoMensajeBytes": 16384,
      "CapacidadBuffer": 10,
      "BufferAplicacionBytes": 32768,
      "BufferTransporteBytes": 32768,
      "SegundosHandshake": 10,
      "TamanoLote": 20,
      "SegundosLease": 30,
      "MilisegundosSondeo": 500
    }
  }
}
