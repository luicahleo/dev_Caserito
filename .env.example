# Configuración local. Copiar como .env y completar sin usar datos personales reales.
SA_PASSWORD=

# Bootstrap opt-in exclusivo de Development para pruebas manuales de fases 1–3.
CASERITO_BOOTSTRAP_ENABLED=false

CASERITO_BOOTSTRAP_ADMIN_EMAIL=
CASERITO_BOOTSTRAP_ADMIN_PASSWORD=
CASERITO_BOOTSTRAP_ADMIN_NAME=
CASERITO_BOOTSTRAP_ADMIN_CITY=

CASERITO_BOOTSTRAP_SELLER_EMAIL=
CASERITO_BOOTSTRAP_SELLER_PASSWORD=
CASERITO_BOOTSTRAP_SELLER_NAME=
CASERITO_BOOTSTRAP_SELLER_CITY=

CASERITO_BOOTSTRAP_BUYER_EMAIL=
CASERITO_BOOTSTRAP_BUYER_PASSWORD=
CASERITO_BOOTSTRAP_BUYER_NAME=
CASERITO_BOOTSTRAP_BUYER_CITY=

# API key opcional para el header X-Service-Key al llamar a ARGOS.
ARGOS_API_KEY=

# OAuth web del backend. Usar secretos locales/gestor del despliegue; nunca versionar valores reales.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Facebook__AppId=
Authentication__Facebook__AppSecret=
