# Configuración local. Copiar como .env y completar sin usar datos personales reales.
SA_PASSWORD=

# Bootstrap opt-in exclusivo de Development para pruebas manuales de fases 1–3.
CASERITO_SEED_USERS_ENABLED=false
CASERITO_SEED_USERS_PASSWORD=
CASERITO_SEED_EMAIL_ADMIN_PLATAFORMA=
CASERITO_SEED_EMAIL_REVISOR_KYC=
CASERITO_SEED_EMAIL_MODERADOR=
CASERITO_SEED_EMAIL_SOPORTE=
CASERITO_SEED_EMAIL_VENDEDOR_1=
CASERITO_SEED_EMAIL_VENDEDOR_2=
CASERITO_SEED_EMAIL_COMPRADOR_1=
CASERITO_SEED_EMAIL_COMPRADOR_2=
CASERITO_SEED_EMAIL_PENDIENTE=
CASERITO_SEED_EMAIL_KYC_NO_INICIADO=
CASERITO_SEED_EMAIL_KYC_PENDIENTE=
CASERITO_SEED_EMAIL_KYC_RECHAZADO=

# API key opcional para el header X-Service-Key al llamar a ARGOS.
ARGOS_API_KEY=

# OAuth web del backend. Usar secretos locales/gestor del despliegue; nunca versionar valores reales.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Facebook__AppId=
Authentication__Facebook__AppSecret=

# Simulador social del entorno PC2. Debe coincidir con una cuenta sintética local
# para probar el escenario de vinculación; nunca usar un correo real.
CASERITO_SIMULADOR_CORREO_EXISTENTE=comprador@caserito.test
