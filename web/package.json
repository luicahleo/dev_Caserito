    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.9.5",
    "typescript": "~6.0.2",
