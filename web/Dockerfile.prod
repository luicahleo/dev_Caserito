# Dockerfile de producción para la aplicación web
# Multi-stage: compilar código fuente Node → servir con NGINX

# Etapa 1: Compilar la aplicación (Node + npm)
FROM node:22-alpine AS build

WORKDIR /app

# Copiar archivos de dependencias
COPY package*.json ./

# Instalar dependencias con npm ci (reproducible, más confiable que npm install)
RUN npm ci

# Copiar el código fuente
COPY . .

# Compilar la aplicación (genera el directorio 'dist')
RUN npm run build

# Etapa 2: Servir la aplicación compilada con NGINX
FROM nginx:alpine

# Copiar archivos compilados de la etapa anterior al directorio web de NGINX
COPY --from=build /app/dist /usr/share/nginx/html

# Exponer puerto HTTP
EXPOSE 80
