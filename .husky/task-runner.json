{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "dotnet-format-staged",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [ "format", "CaseritoApp/CaseritoApp.sln", "--include", "${staged}", "--verify-no-changes", "--exclude-diagnostics", "CA1502", "CA1505", "CA1506" ],
      "include": [ "**/*.cs" ]
    }
  ]
}
