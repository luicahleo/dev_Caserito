{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "dotnet-format-staged",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [ "format", "CaseritoApp/CaseritoApp.sln", "--include", "${staged}", "--verify-no-changes" ],
      "include": [ "**/*.cs" ]
    }
  ]
}
